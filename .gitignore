# ── 依赖 ────────────────────────────────────────────────────────
node_modules/

# 🔴 lib/ 是构建产物，但**故意提交进版本库**：
#    `dsh plugin add github:<owner>/dsh-remote-qqbot` 装的是 git 里的文件，
#    而 git 没有「安装时构建」这一步（pnpm 默认还会拦掉 prepare 脚本）。
#    不提交 lib/ → 用户装完得到一个没有代码的包，`main: lib/index.js` 直接找不到。
# 纪律：改完 src/ 必须 `npm run build` 再提交，且 **build 与提交要在同一次** 完成。
# （`npm test` 会比对 lib/ 与 src/ 的一致性，见 tests/load-verify.mjs）

# ── 打包产物 ────────────────────────────────────────────────────
*.tgz

# ── 运行时状态（本机生成，换机器无意义）─────────────────────────
.collab-state.json
*.bak
*.bak-*
*.orig
*.log

# ── 编辑器 / 系统 ───────────────────────────────────────────────
.vscode/
.idea/
Thumbs.db
desktop.ini
*.swp

# ── 临时验证现场 ────────────────────────────────────────────────
.tmp/
tmp/
_probe/
# work/ 里混着两类东西：
#   ① qq-menu.mjs —— 读写 QQ 自定义菜单/指令面板的运维工具（带 5 条实测铁律），
#      2026-10-04 起入库：它是**能改线上机器人配置的工具**，丢了只剩服务器上的既成事实；
#   ② qq-menu-backup-*.json / menu-*.json —— 每次 get 存的运行态备份，换机器无意义，仍然忽略。
# 写法必须是 `work/*` 而不是 `work/`：目录整体被排除时，后面的 `!` 反向规则不生效。
work/*
!work/qq-menu.mjs
Temp/

# ── 服务端运行时数据 ────────────────────────────────────────────
server/**/data/
server/**/*.pid
.env
.env.*
deploy.local.sh
